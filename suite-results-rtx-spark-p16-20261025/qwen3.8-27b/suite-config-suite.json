{
  "suite_name": "rtx-spark-p16-qwen3.8-27b-suite",
  "targets": [
    {
      "name": "qwen3.8-27b",
      "server": "lmstudio",
      "base_url": "http://127.0.0.1:8099",
      "model": "qwen3.8-27b",
      "runtime": "llama.cpp b11671 (CUDA 13, Windows on Arm) llama-server",
      "gpu": "NVIDIA RTX Spark N1X (Blackwell, 6144 CUDA cores), 128 GB LPDDR5X unified, ASUS ProArt P16",
      "quantization": "UD-Q4_K_M",
      "context_size": 65536,
      "notes": "server: --host 127.0.0.1 --port 8099 --alias qwen3.8-27b -ngl 999 --fit off -fa on -c 65536 -np 32 --kv-unified -b 2048 -ub 2048 --no-cache-prompt --cache-ram 0 --jinja --no-webui --metrics --reasoning off"
    }
  ],
  "scenarios": [
    {
      "name": "01_latency_single_user",
      "description": "Short chat responsiveness and TTFT.",
      "prompt_set": "short_chat",
      "concurrency": "1",
      "max_tokens": 96,
      "warmup": 2,
      "warmup_tokens": 96
    },
    {
      "name": "02_team_concurrency",
      "description": "Shared team chat serving from 1 to 10 users.",
      "prompt_set": "short_chat",
      "concurrency": "1-10",
      "max_tokens": 300,
      "warmup": 2,
      "warmup_tokens": 128
    },
    {
      "name": "03_peak_decode_long_output",
      "description": "Longer generation to reduce fixed request overhead and expose decode throughput.",
      "prompt_set": "short_chat",
      "concurrency": "1,2,4",
      "max_tokens": 1024,
      "warmup": 1,
      "warmup_tokens": 128
    },
    {
      "name": "04_context_4k",
      "description": "Approximate 4K-word long-prompt context pressure test.",
      "prompt_set": "context",
      "approx_prompt_words": 4000,
      "concurrency": "1,2",
      "max_tokens": 160,
      "warmup": 1,
      "warmup_tokens": 64
    },
    {
      "name": "05_context_8k",
      "description": "Approximate 8K-word long-prompt context pressure test.",
      "prompt_set": "context",
      "approx_prompt_words": 8000,
      "concurrency": "1",
      "max_tokens": 160,
      "warmup": 1,
      "warmup_tokens": 64
    },
    {
      "name": "06_coding_smoke",
      "description": "Coding-oriented prompt set for qualitative review plus performance.",
      "prompt_set": "coding",
      "concurrency": "1,2",
      "max_tokens": 384,
      "warmup": 1,
      "warmup_tokens": 96
    },
    {
      "name": "07_vietnamese_smoke",
      "description": "Vietnamese content and explanation prompts.",
      "prompt_set": "vietnamese",
      "concurrency": "1,2",
      "max_tokens": 384,
      "warmup": 1,
      "warmup_tokens": 96
    },
    {
      "name": "08_extraction_classification",
      "description": "Structured extraction and classification tasks.",
      "prompt_set": "classification",
      "concurrency": "1,4",
      "max_tokens": 256,
      "warmup": 1,
      "warmup_tokens": 64
    },
    {
      "name": "09_context_16k",
      "description": "Approximate 16K-word (~21K token) long-prompt prefill test.",
      "prompt_set": "context",
      "approx_prompt_words": 16000,
      "concurrency": "1",
      "max_tokens": 160,
      "warmup": 1,
      "warmup_tokens": 64
    },
    {
      "name": "10_team_stress",
      "description": "Team serving beyond 10 users.",
      "prompt_set": "short_chat",
      "concurrency": "12,16,24,32",
      "max_tokens": 300,
      "warmup": 1,
      "warmup_tokens": 64
    }
  ]
}