{"text": "<style>\n  /* RTX Spark benchmark report: a finding sentence per section, charts in cards, NVIDIA green for this laptop.\n     Blocks between only:/unless: comments are kept or dropped by build_report.py. */\n  .rs { --rs-nv: #5e9e00; font-family: var(--font-anthropic-sans); color: var(--color-fg); display: grid; gap: var(--cds-gap-xl); }\n  .rs b { font-weight: 600; }\n  .rs-head { display: grid; gap: var(--cds-gap-sm); }\n  .rs-title { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); line-height: 1.15; margin: 0; text-wrap: balance; }\n  .rs-sub { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); margin: 0; }\n  .rs-take { font-size: var(--cds-font-size-heading); line-height: 1.45; margin: var(--cds-gap-xs) 0 0; max-width: 72ch; }\n  .rs-nav { display: flex; flex-wrap: wrap; gap: var(--cds-gap-xs) var(--cds-gap-md); font-size: var(--cds-font-size-caption); margin-top: var(--cds-gap-xs); }\n  .rs-nav a { color: var(--color-fg-muted); text-decoration: none; border-bottom: 1px solid var(--color-border-line); padding-bottom: 2px; }\n  .rs-nav a:hover { color: var(--color-fg); border-bottom-color: var(--rs-nv); }\n  .rs-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); gap: var(--cds-gap-md); }\n  .rs-tile { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: grid; gap: var(--cds-gap-xs); align-content: start; border-top: 2px solid var(--rs-nv); }\n  .rs-tile .k { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .rs-tile .v { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); line-height: 1.1; font-variant-numeric: tabular-nums; }\n  .rs-tile .v small { font-family: var(--font-anthropic-sans); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin-left: 4px; }\n  .rs-tile .n { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); line-height: 1.4; }\n  .rs-sec { display: grid; gap: var(--cds-gap-md); scroll-margin-top: 16px; }\n  .rs-sec h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; }\n  .rs-find { margin: 0; max-width: 80ch; line-height: 1.55; }\n  .rs-pending { margin: 0; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .rs-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr)); gap: var(--cds-gap-md); }\n  .rs-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: grid; gap: var(--cds-gap-sm); align-content: start; min-width: 0; }\n  .rs-card h3 { font-size: var(--cds-font-size-body); font-weight: var(--cds-font-weight-medium); margin: 0; }\n  .rs-card .note { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin: 0; line-height: 1.45; }\n  .rs-chart { position: relative; min-height: 220px; }\n  .rs-chart svg { display: block; overflow: visible; }\n  .rs-chart text { font-family: var(--font-anthropic-sans); font-size: var(--cds-font-size-caption); fill: var(--color-fg-muted); font-variant-numeric: tabular-nums; }\n  .rs-chart text.lbl, .rs-chart text.val { fill: var(--color-fg); }\n  .rs-chart text.head { font-weight: var(--cds-font-weight-medium); }\n  .rs-chart line.grid { stroke: var(--cds-chart-grid); }\n  .rs-chart line.axis { stroke: var(--cds-chart-axis); }\n  .rs-chart line.rule { stroke: var(--cds-chart-reference); }\n  .rs-chart path.line { fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }\n  .rs-legend { display: flex; flex-wrap: wrap; gap: 4px var(--cds-gap-md); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin-bottom: var(--cds-gap-xs); }\n  .rs-legend span { display: inline-flex; align-items: center; gap: 6px; }\n  .rs-legend i { width: 12px; height: 3px; border-radius: 2px; display: inline-block; }\n  .rs-tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); white-space: nowrap; display: none; z-index: 2; line-height: 1.5; }\n  .rs-tip .h { color: var(--cds-text-secondary); }\n  .rs-tip .sw { display: inline-block; width: 8px; height: 8px; border-radius: 2px; margin-right: 6px; }\n  .rs-fail { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: inherit; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .rs-fail .dot { width: 0.375rem; height: 0.375rem; border-radius: 50%; background: var(--color-bad); }\n  .rs-tablewrap { overflow-x: auto; }\n  .rs table { width: 100%; border-collapse: collapse; font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }\n  .rs th { text-align: right; color: var(--color-fg-muted); font-weight: 500; padding: 6px 8px; border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n  .rs td { text-align: right; padding: 6px 8px; border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n  .rs th:first-child, .rs td:first-child, .rs th.txt, .rs td.txt { text-align: left; }\n  .rs td.txt { white-space: normal; min-width: 12rem; }\n  .rs tbody tr:last-child td { border-bottom: 0; }\n  .rs-uses { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); gap: var(--cds-gap-md); }\n  .rs-use { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: grid; gap: var(--cds-gap-xs); align-content: start; }\n  .rs-use .tag { font-size: var(--cds-font-size-caption); font-weight: 600; }\n  .rs-use .tag.ok { color: var(--color-ok); }\n  .rs-use .tag.warn { color: var(--color-warn); }\n  .rs-use .tag.bad { color: var(--color-bad); }\n  .rs-use h3 { margin: 0; font-size: var(--cds-font-size-body); font-weight: var(--cds-font-weight-medium); }\n  .rs-use p { margin: 0; line-height: 1.5; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .rs-use p b { color: var(--color-fg); }\n  .rs-shots { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: var(--cds-gap-md); }\n  .rs-shots figure { margin: 0; display: grid; gap: 6px; align-content: start; }\n  .rs-shots img { width: 100%; height: auto; border-radius: var(--cds-radius); border: 1px solid var(--color-border-line); aspect-ratio: 16 / 9; object-fit: cover; display: block; }\n  .rs-shots figcaption { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); line-height: 1.4; }\n  .rs-list { margin: 0; padding-left: 1.1rem; display: grid; gap: 6px; line-height: 1.5; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); max-width: 90ch; }\n  .rs-credit { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); border-top: 1px solid var(--color-border-line); padding-top: var(--cds-pad-md); margin: 0; }\n  .rs-credit b { color: var(--color-fg); }\n  [data-dash-source-state=empty] { color: transparent; }\n  [data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n  @media (prefers-reduced-motion: no-preference) {\n    .rs-chart svg.rs-in { animation: rs-rise var(--cds-dur-slow) var(--cds-ease-out) both; }\n    @keyframes rs-rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }\n  }\n</style>\n\n<div class=\"rs\">\n  <header class=\"rs-head\" id=\"summary\">\n    <h1 class=\"rs-title\" id=\"title\">RTX Spark LLM Benchmark</h1>\n    <p class=\"rs-sub\">ASUS ProArt P16 with NVIDIA RTX Spark N1X (Blackwell GPU, 20-core Arm CPU) and 128 GB of unified memory · Windows 11 on Arm · llama.cpp b11671 · tested 25–26 October 2026</p>\n    <p class=\"rs-take\" id=\"takeaway\">Qwen3.6-35B-A3B writes <b data-source=\"bench\" data-field=\"tps\" data-where=\"model=qwen3.6-35b-a3b&amp;set=classic&amp;test=tg128\" class=\"dash-skeleton\">—</b> tok/s for one person, Qwen3.8-27B writes code at <b data-source=\"spec\" data-field=\"gen_tps\" data-where=\"config=dflash2\" class=\"dash-skeleton\">—</b> tok/s with speculative decoding, a 120B model runs at <b data-source=\"vramsum\" data-field=\"tg_96\" class=\"dash-skeleton\">—</b> tok/s, and decode speed is within <b data-source=\"dgxratio\" data-field=\"decode_gap_pct\" class=\"dash-skeleton\">—</b>% of a DGX Spark. It is a strong single-user and small-team AI workstation, not a production server.</p>\n    <nav class=\"rs-nav\" aria-label=\"Sections\">\n      <a href=\"#uses\" data-go=\"uses\">Use cases</a><a href=\"#speed\" data-go=\"speed\">Speed</a><a href=\"#context\" data-go=\"context\">Long context</a><a href=\"#team\" data-go=\"team\">Team serving</a><a href=\"#speculative\" data-go=\"speculative\">Speculative decoding</a><a href=\"#memory\" data-go=\"memory\">GPU memory</a><a href=\"#dgx\" data-go=\"dgx\">vs DGX Spark</a><a href=\"#coding\" data-go=\"coding\">Coding test</a><a href=\"#power\" data-go=\"power\">Power</a><a href=\"#method\" data-go=\"method\">Method</a>\n    </nav>\n  </header>\n\n  <section class=\"rs-tiles\" id=\"tiles\" aria-label=\"Headline figures\">\n    <div class=\"rs-tile\"><span class=\"k\">Qwen3.6-35B-A3B, one person</span><span class=\"v\"><span data-source=\"bench\" data-field=\"tps\" data-where=\"model=qwen3.6-35b-a3b&amp;set=classic&amp;test=tg128\" class=\"dash-skeleton\">—</span><small>tok/s</small></span><span class=\"n\">writing speed; it reads prompts at <span data-source=\"bench\" data-field=\"tps\" data-where=\"model=qwen3.6-35b-a3b&amp;set=sweep&amp;test=pp2048&amp;depth=0\">—</span> tok/s</span></div>\n    <div class=\"rs-tile\"><span class=\"k\">Qwen3.8-27B writing code</span><span class=\"v\"><span data-source=\"spec\" data-field=\"gen_tps\" data-where=\"config=dflash2\" class=\"dash-skeleton\">—</span><small>tok/s</small></span><span class=\"n\">with the DFlash2 draft model, <span data-source=\"specgain\" data-field=\"gain_x\" data-where=\"config=dflash2\">—</span>× its plain <span data-source=\"spec\" data-field=\"gen_tps\" data-where=\"config=none\">—</span> tok/s</span></div>\n    \n    <div class=\"rs-tile\"><span class=\"k\">Long context</span><span class=\"v\"><span data-source=\"depthkeep\" data-field=\"pct\" data-where=\"model=qwen3.6-35b-a3b&amp;test=tg32&amp;depth=32768\" class=\"dash-skeleton\">—</span><small>% kept</small></span><span class=\"n\">of Qwen3.6-35B-A3B's writing speed with 32K tokens already in context</span></div>\n    <div class=\"rs-tile\"><span class=\"k\">Biggest model, 120B</span><span class=\"v\"><span data-source=\"vramsum\" data-field=\"tg_96\" class=\"dash-skeleton\">—</span><small>tok/s</small></span><span class=\"n\">Nemotron 3.5 Super, <span data-source=\"models\" data-field=\"size_gb\" data-where=\"model=nemotron-3.5-super-120b\">—</span> GB of weights, all on the GPU</span></div>\n    <div class=\"rs-tile\"><span class=\"k\">Fastest model</span><span class=\"v\"><span data-source=\"fastest\" data-field=\"tps\" class=\"dash-skeleton\">—</span><small>tok/s</small></span><span class=\"n\"><span data-source=\"fastest\" data-field=\"short\">—</span>; reads prompts at <span data-source=\"fastest\" data-field=\"pp2048\">—</span> tok/s</span></div>\n    <div class=\"rs-tile\"><span class=\"k\">Same test as a DGX Spark</span><span class=\"v\"><span data-source=\"dgxratio\" data-field=\"decode_pct\" class=\"dash-skeleton\">—</span><small>% of its decode</small></span><span class=\"n\"><span data-source=\"dgxratio\" data-field=\"prefill_pct\">—</span>% of its prompt reading, gpt-oss-20b, empty context</span></div>\n  </section>\n\n  <section class=\"rs-sec\" id=\"uses\">\n    <h2 id=\"uses-title\">What it can do</h2>\n    <p class=\"rs-find\">Each card names the model that fits the job best on this laptop, with the measured number that decides it.</p>\n    <div class=\"rs-uses\">\n      <article class=\"rs-use\"><span class=\"tag ok\">Works well</span><h3>Personal coding agent</h3><p>Qwen3.8-27B with the DFlash2 draft writes HTML at <b data-source=\"spec\" data-field=\"html_tps\" data-where=\"config=dflash2\">—</b> tok/s. One prompt produced a complete <b data-source=\"coding\" data-field=\"html_lines\" data-where=\"run=neon-spark\">—</b>-line arcade game in <b data-source=\"coding\" data-field=\"total_min\" data-where=\"run=neon-spark\">—</b> minutes, thinking included.</p></article>\n      <article class=\"rs-use\"><span class=\"tag ok\">Works well</span><h3>Fast chat and agents</h3><p>Qwen3.6-35B-A3B writes <b data-source=\"bench\" data-field=\"tps\" data-where=\"model=qwen3.6-35b-a3b&amp;set=classic&amp;test=tg128\">—</b> tok/s and reads <b data-source=\"bench\" data-field=\"tps\" data-where=\"model=qwen3.6-35b-a3b&amp;set=sweep&amp;test=pp2048&amp;depth=0\">—</b> tok/s, so a typical reply takes seconds and tool-calling loops stay snappy.</p></article>\n      \n      <article class=\"rs-use\"><span class=\"tag ok\">Works well</span><h3>Long documents and RAG</h3><p>With 32K tokens already in context, Qwen3.6-35B-A3B keeps <b data-source=\"depthkeep\" data-field=\"pct\" data-where=\"model=qwen3.6-35b-a3b&amp;test=tg32&amp;depth=32768\">—</b>% of its writing speed and <b data-source=\"depthkeep\" data-field=\"pct\" data-where=\"model=qwen3.6-35b-a3b&amp;test=pp2048&amp;depth=32768\">—</b>% of its reading speed.</p></article>\n      <article class=\"rs-use\"><span class=\"tag ok\">Works well</span><h3>Working unplugged</h3><p>Speed holds on battery: Qwen3.6-35B-A3B wrote <b data-source=\"battery\" data-field=\"tps\" data-where=\"power_id=battery&amp;test=tg128\">—</b> tok/s unplugged and <b data-source=\"battery\" data-field=\"tps\" data-where=\"power_id=charger&amp;test=tg128\">—</b> on the 65 W charger. Long heavy runs drain the battery even when plugged into 65 W.</p></article>\n      <article class=\"rs-use\"><span class=\"tag ok\">Works</span><h3>Frontier-size models offline</h3><p>Nemotron 3.5 Super (120B) runs fully on the GPU at <b data-source=\"vramsum\" data-field=\"tg_96\">—</b> tok/s: fine for careful reasoning and agent steps, slow for chat.</p></article>\n      <article class=\"rs-use\"><span class=\"tag warn\">With care</span><h3>Models over 80 GB</h3><p>Qwen3.8-Flash-Next (<b data-source=\"models\" data-field=\"size_gb\" data-where=\"model=qwen3.8-flash-next\">—</b> GB) keeps a <b data-source=\"facts\" data-field=\"value\" data-where=\"fact=flash_next_embd_gb\">—</b> GB embedding table in system RAM. At the 96 GB GPU setting Windows ran out of RAM and prompt reading fell to <b data-source=\"vram\" data-field=\"pp512\" data-where=\"run_id=r7\">—</b> tok/s, against <b data-source=\"vram\" data-field=\"pp512\" data-where=\"run_id=r6\">—</b> at the 50 GB setting.</p></article>\n      <article class=\"rs-use\"><span class=\"tag bad\">Not a fit</span><h3>Dense giants and heavy production serving</h3><p>Decode speed is set by memory bandwidth: the dense Qwen3.8-27B writes <b data-source=\"bench\" data-field=\"tps\" data-where=\"model=qwen3.8-27b&amp;set=classic&amp;test=tg128\">—</b> tok/s without speculation, so dense 70B-class models are too slow for chat, and dozens of busy users need a server GPU.</p></article>\n    </div>\n  </section>\n\n  <section class=\"rs-sec\" id=\"speed\">\n    <h2 id=\"speed-title\">Raw speed, one person</h2>\n    <p class=\"rs-find\">Mixture-of-experts models read only a few billion parameters for each token, so Qwen3.6-35B-A3B writes <b data-source=\"moegain\" data-field=\"ratio_x\">—</b>× faster than the dense Qwen3.8-27B. Reading a prompt (prefill) is compute-bound and favours small and MXFP4 models.</p>\n    <div class=\"rs-grid\">\n      <div class=\"rs-card\"><h3>Writing speed (decode)</h3><p class=\"note\">llama-bench tg128, empty context, tokens per second</p><div class=\"rs-chart dash-skeleton\" id=\"decode-chart\" data-source=\"bench models\"></div></div>\n      <div class=\"rs-card\"><h3>Reading speed (prefill)</h3><p class=\"note\">llama-bench pp512, tokens per second</p><div class=\"rs-chart dash-skeleton\" id=\"prefill-chart\" data-source=\"bench models\"></div></div>\n    </div>\n    <div class=\"rs-card\"><h3>Models tested</h3><p class=\"note\">Sizes in binary GB, as Windows shows them; active is the billions of parameters read for each token</p>\n      <div class=\"rs-tablewrap\"><table id=\"models-table\" data-source=\"models\" data-row-key=\"model\"><thead><tr><th data-field=\"short\">Model</th><th data-field=\"kind\" class=\"txt\">Design</th><th data-field=\"params_b\">Params (B)</th><th data-field=\"active_b\">Active (B)</th><th data-field=\"quant\">Quant</th><th data-field=\"size_gb\">Size (GB)</th><th data-field=\"released\">Released</th></tr></thead><tbody></tbody></table></div></div>\n  </section>\n\n  <section class=\"rs-sec\" id=\"context\">\n    <h2 id=\"context-title\">Long context</h2>\n    <p class=\"rs-find\">Models that mix attention with linear-time layers (DeltaNet in Qwen3.6 and 3.8, Mamba-2 in Nemotron) barely slow down as the context fills. Plain-attention Qwen3-4B keeps only <b data-source=\"depthkeep\" data-field=\"pct\" data-where=\"model=qwen3-4b-2507&amp;test=tg32&amp;depth=32768\">—</b>% of its writing speed at 32K tokens, while Nemotron 3.5 Super keeps <b data-source=\"depthkeep\" data-field=\"pct\" data-where=\"model=nemotron-3.5-super-120b&amp;test=tg32&amp;depth=32768\">—</b>%.</p>\n    <div class=\"rs-grid\">\n      <div class=\"rs-card\"><h3>Writing speed as the context fills</h3><p class=\"note\">llama-bench tg32 at each context depth, as a share of the speed with an empty context</p><div class=\"rs-chart dash-skeleton\" id=\"depth-tg-chart\" data-source=\"depthkeep models\"></div></div>\n      <div class=\"rs-card\"><h3>Reading speed as the context fills</h3><p class=\"note\">llama-bench pp2048 at each context depth, as a share of the speed with an empty context</p><div class=\"rs-chart dash-skeleton\" id=\"depth-pp-chart\" data-source=\"depthkeep models\"></div></div>\n    </div>\n  </section>\n\n  <section class=\"rs-sec\" id=\"team\">\n    <h2 id=\"team-title\">Serving a team</h2>\n    <p class=\"rs-pending\">The concurrency suite (1 to 32 people sending chat requests at the same moment) is still running on the laptop; its charts land here when it finishes.</p>\n    \n  </section>\n\n  \n\n  <section class=\"rs-sec\" id=\"speculative\">\n    <h2 id=\"speculative-title\">Speculative decoding</h2>\n    <p class=\"rs-find\">A small draft guesses the next tokens and the 27B checks several at once. On this memory-bound chip the check is nearly free, so Qwen3.8-27B writes <b data-source=\"specgain\" data-field=\"gain_x\" data-where=\"config=dflash2\">—</b>× faster with the DFlash2 draft model. Code gains the most because it is the most predictable text.</p>\n    <div class=\"rs-grid\">\n      <div class=\"rs-card\"><h3>Qwen3.8-27B, one person</h3><p class=\"note\">Average tok/s over three prompts of 768 tokens each, and the share of drafted tokens accepted</p><div class=\"rs-chart dash-skeleton\" id=\"spec-chart\" data-source=\"spec\"></div></div>\n      <div class=\"rs-card\"><h3>By kind of text</h3><p class=\"note\">tok/s writing an HTML page, a Python module and a prose explanation</p><div class=\"rs-chart dash-skeleton\" id=\"spec-kind-chart\" data-source=\"spec\"></div></div>\n      \n    </div>\n  </section>\n\n  <section class=\"rs-sec\" id=\"memory\">\n    <h2 id=\"memory-title\">Big models and the GPU memory setting</h2>\n    <p class=\"rs-find\">The NVIDIA App sets how much of the 128 GB is dedicated to the GPU (50 GB at first here, 96 GB at most). At 50 GB, CUDA can still address <b data-source=\"facts\" data-field=\"value\" data-where=\"fact=cuda_addressable_gb\">—</b> GB, because Windows lends the rest as shared memory, so big models load either way. Weights held entirely in shared memory write <b data-source=\"sharedsum\" data-field=\"best_drop_pct\">—</b>–<b data-source=\"sharedsum\" data-field=\"worst_drop_pct\">—</b>% slower; Nemotron 3.5 Super, which put <b data-source=\"vram\" data-field=\"shared_gb\" data-where=\"run_id=r1\">—</b> GB in shared memory at 50 GB, gains <b data-source=\"vramsum\" data-field=\"tg_gain_pct\">—</b>% writing and <b data-source=\"vramsum\" data-field=\"pp_gain_pct\">—</b>% reading speed at 96 GB.</p>\n    <div class=\"rs-grid\">\n      <div class=\"rs-card\"><h3>Dedicated vs shared memory</h3><p class=\"note\">Same model and setting; for the shared run an idle process first filled the dedicated pool so the weights landed in shared memory</p><div class=\"rs-chart dash-skeleton\" id=\"shared-chart\" data-source=\"shared models\"></div></div>\n      <div class=\"rs-card\"><h3>50 GB vs 96 GB setting</h3><p class=\"note\">llama-bench pp512 and tg128 tok/s; memory columns are peaks during the run</p>\n        <div class=\"rs-tablewrap\"><table id=\"vram-table\" data-source=\"vram\" data-row-key=\"run_id\"><thead><tr><th data-field=\"model\">Model</th><th data-field=\"setting_gb\">Setting (GB)</th><th data-field=\"run\" class=\"txt\">Run</th><th data-field=\"pp512\">Reading</th><th data-field=\"tg128\">Writing</th><th data-field=\"dedicated_gb\">Dedicated (GB)</th><th data-field=\"shared_gb\">Shared (GB)</th><th data-field=\"ram_free_min_gb\">RAM free (GB)</th></tr></thead><tbody></tbody></table></div>\n        <p class=\"note\">The first 96 GB run after the reboot was faster and never repeated, so the 96 GB average uses the three runs that agree. Qwen3.8-Flash-Next crashed at 50 GB with CUDA's default lazy kernel loading and ran with CUDA_MODULE_LOADING=EAGER.</p></div>\n    </div>\n  </section>\n\n  <section class=\"rs-sec\" id=\"dgx\">\n    <h2 id=\"dgx-title\">Laptop vs DGX Spark</h2>\n    <p class=\"rs-find\">The same llama-bench command as llama.cpp's published DGX Spark table, on gpt-oss-20b. The laptop decodes at <b data-source=\"dgxratio\" data-field=\"decode_pct\">—</b>% of the DGX Spark's speed and reads prompts at <b data-source=\"dgxratio\" data-field=\"prefill_pct\">—</b>% with an empty context. The DGX table used an older llama.cpp (b7941) on Linux, so part of the prefill lead is software.</p>\n    <div class=\"rs-grid\">\n      <div class=\"rs-card\"><h3>Writing speed</h3><p class=\"note\">tg32 tok/s at each context depth</p><div class=\"rs-chart dash-skeleton\" id=\"dgx-tg-chart\" data-source=\"dgx\"></div></div>\n      <div class=\"rs-card\"><h3>Reading speed</h3><p class=\"note\">pp2048 tok/s at each context depth</p><div class=\"rs-chart dash-skeleton\" id=\"dgx-pp-chart\" data-source=\"dgx\"></div></div>\n    </div>\n  </section>\n\n  <section class=\"rs-sec\" id=\"coding\">\n    <h2 id=\"coding-title\">Real-life coding test</h2>\n    <p class=\"rs-find\">Qwen3.8-27B with the DFlash2 draft and medium reasoning effort, entirely on the laptop. Each app came from a single prompt with no edits. The one-shot game looked great but skipped straight past its opening waves; a fully iterated version, built by follow-up prompts to the same local model, is still being refined and lands here when it is final.</p>\n    \n    <div class=\"rs-grid\">\n      <div class=\"rs-card\"><h3>One-shot prompts</h3><p class=\"note\">One prompt each, no edits; minutes include thinking</p>\n        <div class=\"rs-tablewrap\"><table id=\"coding-table\" data-source=\"coding\" data-row-key=\"run\"><thead><tr><th data-field=\"app\">App</th><th data-field=\"total_min\">Minutes</th><th data-field=\"thinking_min\">Thinking</th><th data-field=\"completion_tokens\">Tokens</th><th data-field=\"decode_tps\">tok/s</th><th data-field=\"html_lines\">Lines</th></tr></thead><tbody></tbody></table></div></div>\n      \n    </div>\n    <div class=\"rs-shots\" id=\"shots\"></div>\n  </section>\n\n  <section class=\"rs-sec\" id=\"power\">\n    <h2 id=\"power-title\">Power and battery</h2>\n    <p class=\"rs-find\">While benchmarking, the GPU averaged <b data-source=\"powersum\" data-field=\"min_w\">—</b> to <b data-source=\"powersum\" data-field=\"max_w\">—</b> W. Under load the whole laptop draws more than a 65 W charger supplies, so the battery runs down even while plugged in, but speed holds: Qwen3.6-35B-A3B decoded <b data-source=\"battery\" data-field=\"tps\" data-where=\"power_id=battery&amp;test=tg128\">—</b> tok/s on battery and <b data-source=\"battery\" data-field=\"tps\" data-where=\"power_id=charger&amp;test=tg128\">—</b> on the charger.</p>\n    <div class=\"rs-grid\">\n      <div class=\"rs-card\"><h3>GPU power while benchmarking</h3><p class=\"note\">Average watts during llama-bench while the GPU was busy, from nvidia-smi</p><div class=\"rs-chart dash-skeleton\" id=\"power-chart\" data-source=\"power models\"></div></div>\n      <div class=\"rs-card\"><h3>Battery vs 65 W charger</h3><p class=\"note\">Qwen3.6-35B-A3B, the same llama-bench command minutes apart</p>\n        <div class=\"rs-tablewrap\"><table id=\"battery-table\" data-source=\"battery\" data-row-key=\"power_id,test\"><thead><tr><th data-field=\"power\">Power</th><th data-field=\"test\">Test</th><th data-field=\"tps\">tok/s</th><th data-field=\"sd\">±</th><th data-field=\"reps\">Runs</th></tr></thead><tbody></tbody></table></div></div>\n    </div>\n  </section>\n\n  <section class=\"rs-sec\" id=\"method\">\n    <h2 id=\"method-title\">Method</h2>\n    <ul class=\"rs-list\">\n      <li>Runtime: llama.cpp b11671 (CUDA 13, Windows on Arm) with every layer on the GPU and flash attention on. llama-bench for raw speed, llama-batched-bench for the engine ceiling, and the concurrency-benchmark-llm suite against llama-server for what a person feels.</li>\n      <li>Server: one slot per simulated person, a unified KV cache, prompt caching off so every request pays its full prompt reading, and reasoning off so answers are visible text (gpt-oss at low effort).</li>\n      <li>Speculative decoding is off unless a chart says otherwise; MTP uses Hermes Agent's preset of 2 draft tokens.</li>\n      <li>GPU memory setting: 96 GB for the final runs. The smaller models fit entirely in dedicated memory at either setting. Qwen3.8-Flash-Next appears only in the memory section, because at 96 GB it starves Windows of RAM.</li>\n      <li>Nemotron 3.5 Super kept the GPU busy at low power while decoding, which suggests its speed is limited by today's kernels rather than by memory bandwidth; newer llama.cpp builds may run it faster.</li>\n      <li>Power: a 65 W USB-C charger with Windows set to Best performance; runs paused below 30% battery to recharge.</li>\n      <li>DGX Spark numbers come from llama.cpp's published DGX Spark benchmark table for the same command.</li>\n    </ul>\n    <p class=\"rs-credit\">Benchmark and report for <b>An À Ha</b> · annguyen.work · github.com/an6122003 · YouTube and TikTok @anndaynee</p>\n  </section>\n</div>\n\n<script>\n// Model order sets each model's color everywhere on the page.\nconst ORDER = ['qwen3.6-35b-a3b', 'qwen3.8-27b', 'nemotron-3.5-super-120b', 'gpt-oss-20b', 'nemotron-3.5-nano-30b', 'gemma-4-26b-a4b', 'qwen3-4b-2507', 'gemma-4-e4b'];\nconst LINE_MODELS = ORDER.slice(0, 7);\nconst color = (key) => (ORDER.includes(key) ? dash.colors[ORDER.indexOf(key)] : 'var(--cds-chart-muted)');\nwindow.RS = { ORDER, LINE_MODELS, color };\n\ndash.calc('fastest', {\n  title: 'Fastest model',\n  description: 'The model with the highest llama-bench tg128 speed, and its speed reading a 2,048-token prompt.',\n  inputs: ['bench', 'models'],\n  fn: (bench, models) => {\n    const tg = bench.filter((r) => r.set === 'classic' && r.test === 'tg128');\n    const best = tg.reduce((a, r) => (Number(r.tps) > Number(a.tps) ? r : a), tg[0]);\n    if (!best) return [];\n    const pp = bench.find((r) => r.model === best.model && r.set === 'sweep' && r.test === 'pp2048' && Number(r.depth) === 0);\n    const m = models.find((x) => x.model === best.model);\n    return [{ model: best.model, short: m ? m.short : best.model, tps: best.tps, pp2048: pp ? pp.tps : null }];\n  },\n});\n\ndash.calc('specgain', {\n  title: 'Speculative decoding speed-up',\n  description: 'Each configuration\\'s average tok/s divided by the run without speculation.',\n  inputs: ['spec'],\n  fn: (spec) => {\n    const base = Number((spec.find((r) => r.config === 'none') || {}).gen_tps);\n    return spec.map((r) => ({ config: r.config, gain_x: base ? Math.round((Number(r.gen_tps) / base) * 10) / 10 : null }));\n  },\n});\n\ndash.calc('moegain', {\n  title: 'MoE vs dense writing speed',\n  description: 'Qwen3.6-35B-A3B llama-bench tg128 divided by Qwen3.8-27B\\'s.',\n  inputs: ['bench'],\n  fn: (bench) => {\n    const tg = (model) => Number((bench.find((r) => r.model === model && r.set === 'classic' && r.test === 'tg128') || {}).tps);\n    const ratio = tg('qwen3.6-35b-a3b') / tg('qwen3.8-27b');\n    return ratio ? [{ ratio_x: Math.round(ratio * 10) / 10 }] : [];\n  },\n});\n\ndash.calc('depthkeep', {\n  title: 'Speed kept as context fills',\n  description: 'Each llama-bench sweep result as a percentage of the same model and test with an empty context.',\n  inputs: ['bench'],\n  fn: (bench) => {\n    const sweep = bench.filter((r) => r.set === 'sweep');\n    return sweep.map((r) => {\n      const base = sweep.find((b) => b.model === r.model && b.test === r.test && Number(b.depth) === 0);\n      return { model: r.model, test: r.test, depth: Number(r.depth), tps: r.tps,\n        pct: base ? Math.round((Number(r.tps) / Number(base.tps)) * 100) : null };\n    });\n  },\n});\n\ndash.calc('vramsum', {\n  title: 'Nemotron Super at 50 vs 96 GB',\n  description: 'Nemotron 3.5 Super llama-bench at the 50 GB setting and the mean of the 96 GB runs that agree, with the gains.',\n  inputs: ['vram'],\n  fn: (vram) => {\n    const runs = vram.filter((r) => r.model === 'nemotron-3.5-super-120b' && String(r.in_average) === 'True');\n    const mean = (gb, f) => {\n      const v = runs.filter((r) => Number(r.setting_gb) === gb).map((r) => Number(r[f]));\n      return v.length ? v.reduce((a, b) => a + b, 0) / v.length : null;\n    };\n    const tg50 = mean(50, 'tg128'), tg96 = mean(96, 'tg128'), pp50 = mean(50, 'pp512'), pp96 = mean(96, 'pp512');\n    if (!tg50 || !tg96) return [];\n    return [{ tg_50: Math.round(tg50 * 100) / 100, tg_96: Math.round(tg96 * 10) / 10, pp_50: Math.round(pp50), pp_96: Math.round(pp96),\n      tg_gain_pct: Math.round((tg96 / tg50 - 1) * 100), pp_gain_pct: Math.round((pp96 / pp50 - 1) * 100) }];\n  },\n});\n\ndash.calc('sharedsum', {\n  title: 'Cost of shared GPU memory',\n  description: 'Writing speed with the weights in shared memory against the mean of the dedicated runs, per model, and the range of the drop.',\n  inputs: ['shared'],\n  fn: (shared) => {\n    const mean = (v) => v.reduce((a, b) => a + b, 0) / v.length;\n    const out = [...new Set(shared.map((r) => r.model))].map((model) => {\n      const tg = (placement) => shared.filter((r) => r.model === model && r.placement === placement).map((r) => Number(r.tg128));\n      const ded = mean(tg('dedicated')), sh = mean(tg('shared'));\n      return { model, dedicated_tg: Math.round(ded * 100) / 100, shared_tg: Math.round(sh * 100) / 100, drop_pct: Math.round((1 - sh / ded) * 100) };\n    });\n    const drops = out.map((r) => r.drop_pct);\n    return out.map((r) => ({ ...r, best_drop_pct: Math.min(...drops), worst_drop_pct: Math.max(...drops) }));\n  },\n});\n\ndash.calc('dgxratio', {\n  title: 'Laptop as a share of DGX Spark',\n  description: 'gpt-oss-20b on this laptop divided by the DGX Spark table, with an empty context.',\n  inputs: ['dgx'],\n  fn: (dgx) => {\n    const v = (machine, test) => Number((dgx.find((r) => r.machine === machine && r.test === test && Number(r.depth) === 0) || {}).tps);\n    const dec = v('RTX Spark laptop', 'tg32') / v('DGX Spark', 'tg32');\n    const pre = v('RTX Spark laptop', 'pp2048') / v('DGX Spark', 'pp2048');\n    if (!dec || !pre) return [];\n    return [{ decode_pct: Math.round(dec * 100), prefill_pct: Math.round(pre * 100), decode_gap_pct: Math.round(Math.abs(1 - dec) * 100) }];\n  },\n});\n\ndash.calc('powersum', {\n  title: 'GPU power range',\n  description: 'Lowest and highest average GPU power across the models\\' llama-bench runs.',\n  inputs: ['power'],\n  fn: (power) => {\n    const w = power.filter((r) => r.phase === 'bench').map((r) => Number(r.power_busy_avg_w));\n    return w.length ? [{ min_w: Math.min(...w), max_w: Math.max(...w) }] : [];\n  },\n});\n</script>\n\n<script src=\"shots.js\"></script>\n<script src=\"charts.js\"></script>\n"}